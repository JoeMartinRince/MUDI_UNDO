<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <rect width="1200" height="800" fill="#0b0f19"/>
  <!-- Grid background -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1200" height="800" fill="url(#grid)"/>

  <!-- Top Bar -->
  <rect width="1200" height="60" fill="#111827" stroke="#1f293d" stroke-width="1"/>
  <rect x="30" y="15" width="30" height="30" rx="4" fill="#3b82f6"/>
  <text x="75" y="36" font-family="'IBM Plex Mono', monospace" font-size="20" font-weight="bold" fill="#f8fafc">MUDI UNDO?™</text>
  <text x="210" y="35" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#94a3b8">NATIONAL DEPARTMENT OF HAIR STATISTICS</text>
  <circle cx="1130" cy="30" r="6" fill="#22c55e"/>
  <text x="1145" y="34" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#22c55e">ONLINE</text>

  <!-- Step & Header -->
  <text x="200" y="110" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#64748b">STEP 01 OF 03 · ACQUISITION</text>
  <text x="200" y="145" font-family="'Archivo', sans-serif" font-size="32" font-weight="900" fill="#f8fafc">POSITION YOUR HEAD</text>
  <text x="200" y="175" font-family="'IBM Plex Sans', sans-serif" font-size="14" fill="#94a3b8">Place your head inside the designated position frame for hair telemetry acquisition.</text>

  <!-- Viewfinder Box -->
  <rect x="200" y="210" width="800" height="460" rx="8" fill="#151d2a" stroke="#334155" stroke-width="2"/>
  
  <!-- Simulated Camera Stream / Head Silhouette -->
  <ellipse cx="600" cy="420" rx="140" ry="170" fill="#1e293b" stroke="#ef4444" stroke-width="3" stroke-dasharray="8 6"/>
  <text x="600" y="250" font-family="'IBM Plex Mono', monospace" font-size="13" font-weight="bold" fill="#ef4444" text-anchor="middle">▲ ALIGN VERTEX HERE ▲</text>
  <text x="600" y="640" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#64748b" text-anchor="middle">MAINTAIN 30CM DISTANCE IN GOOD LIGHTING</text>

  <!-- Camera Controls -->
  <rect x="400" y="690" width="400" height="50" rx="4" fill="#ef4444"/>
  <text x="600" y="722" font-family="'Archivo', sans-serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">CAPTURE CENSUS FRAME ➔</text>
</svg>