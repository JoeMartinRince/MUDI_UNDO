<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 950" width="100%" height="100%">
  <rect width="1200" height="950" fill="#0b0f19"/>
  <!-- Top Bar -->
  <rect width="1200" height="60" fill="#111827" stroke="#1f293d" stroke-width="1"/>
  <text x="40" y="36" font-family="'IBM Plex Mono', monospace" font-size="20" font-weight="bold" fill="#f8fafc">MUDI UNDO?™</text>
  <text x="1000" y="35" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#94a3b8">REPORT MU-2026-48291</text>

  <!-- Main Result Box -->
  <rect x="150" y="90" width="900" height="170" rx="6" fill="#151d2a" stroke="#334155" stroke-width="2"/>
  <text x="190" y="130" font-family="'IBM Plex Mono', monospace" font-size="13" font-weight="bold" fill="#38bdf8">HAIR POPULATION</text>
  <text x="190" y="200" font-family="'Archivo', sans-serif" font-size="64" font-weight="900" fill="#f8fafc">47,382</text>
  <text x="190" y="235" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#64748b">ESTIMATED ± 11,420 FOLLICLES</text>

  <!-- Stat Cards Grid -->
  <!-- Card 1 -->
  <rect x="150" y="280" width="210" height="100" rx="4" fill="#1e293b" stroke="#334155" stroke-width="1"/>
  <text x="170" y="310" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#94a3b8">HAIR COVERAGE</text>
  <text x="170" y="355" font-family="'Archivo', sans-serif" font-size="32" font-weight="900" fill="#38bdf8">78.4%</text>

  <!-- Card 2 -->
  <rect x="380" y="280" width="210" height="100" rx="4" fill="#1e293b" stroke="#334155" stroke-width="1"/>
  <text x="400" y="310" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#94a3b8">SCALP EXPOSURE</text>
  <text x="400" y="355" font-family="'Archivo', sans-serif" font-size="32" font-weight="900" fill="#f8fafc">21.6%</text>

  <!-- Card 3 -->
  <rect x="610" y="280" width="210" height="100" rx="4" fill="#1e293b" stroke="#334155" stroke-width="1"/>
  <text x="630" y="310" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#94a3b8">BALDNESS INDEX</text>
  <text x="630" y="355" font-family="'Archivo', sans-serif" font-size="32" font-weight="900" fill="#f8fafc">21.6</text>

  <!-- Card 4 -->
  <rect x="840" y="280" width="210" height="100" rx="4" fill="#1e293b" stroke="#334155" stroke-width="1"/>
  <text x="860" y="310" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#94a3b8">CONFIDENCE</text>
  <text x="860" y="355" font-family="'Archivo', sans-serif" font-size="32" font-weight="900" fill="#22c55e">84.7%</text>

  <!-- Classification Card -->
  <rect x="150" y="405" width="900" height="120" rx="6" fill="#151d2a" stroke="#22c55e" stroke-width="2"/>
  <text x="190" y="445" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#22c55e">ECOLOGICAL CLASSIFICATION</text>
  <text x="190" y="485" font-family="'Archivo', sans-serif" font-size="28" font-weight="900" fill="#f8fafc">🌳 DENSE FOREST</text>
  <text x="190" y="510" font-family="'IBM Plex Sans', sans-serif" font-size="13" fill="#94a3b8">Subject hair density exceeds national thresholds for healthy woodland classification.</text>

  <!-- Final Verdict Section -->
  <rect x="150" y="545" width="900" height="150" rx="6" fill="#151d2a" stroke="#334155" stroke-width="1"/>
  <text x="190" y="585" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#38bdf8">FINAL VERDICT · DOC MU-07</text>
  <text x="190" y="625" font-family="'Archivo', sans-serif" font-size="24" font-weight="900" fill="#f8fafc">HAIR DETECTED.</text>
  <text x="190" y="655" font-family="'IBM Plex Sans', sans-serif" font-size="14" fill="#cbd5e1">The census department confirms that the subject possesses a statistically significant quantity of hair.</text>

  <!-- Action Buttons -->
  <rect x="150" y="720" width="900" height="50" rx="4" fill="#3b82f6"/>
  <text x="600" y="752" font-family="'Archivo', sans-serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">TAKE ANOTHER CENSUS ➔</text>
</svg>